<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Instructor.master.cs" Inherits="EduFlow.Instructor.InstructorMaster" %>
<!DOCTYPE html>
<html lang="tr">
<head runat="server">
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%: Page.Title %> — EduFlow Eğitmen Paneli</title>
  <link href="../Content/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link href="../Content/Site.css" rel="stylesheet" />
  <style>
    /* Eğitmen sidebar — ana site renkleriyle uyumlu */
    .instructor-sidebar {
      background: var(--color-primary);
    }
    .instructor-sidebar .brand {
      color: var(--color-on-primary);
      border-bottom-color: rgba(255,255,255,.12);
    }
    .instructor-sidebar .brand-sub {
      font-size: 11px;
      font-weight: 400;
      color: var(--color-accent);
      margin-top: 2px;
      opacity: .85;
    }
    .instructor-sidebar nav a {
      color: var(--color-on-primary-muted);
    }
    .instructor-sidebar nav a:hover,
    .instructor-sidebar nav a.active {
      background: rgba(255,255,255,.1);
      color: var(--color-on-primary);
    }
    .instructor-sidebar nav a.active {
      border-left: 3px solid var(--color-accent);
      padding-left: calc(var(--sidebar-link-px, 16px) - 3px);
    }
    .instructor-sidebar .sidebar-section-label {
      color: rgba(255,255,255,.35);
    }
    .instructor-topbar {
      border-bottom: 1px solid var(--color-border);
    }
    .instructor-topbar h1 {
      color: var(--color-primary);
      font-size: 1.25rem;
      font-weight: 600;
    }
    /* Stat kartları */
    .stat-card-ins {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 22px 20px;
      transition: box-shadow var(--transition), transform var(--transition);
    }
    .stat-card-ins:hover {
      box-shadow: 0 6px 20px rgba(30,58,95,.08);
      transform: translateY(-2px);
    }
    .stat-icon-ins {
      width: 46px;
      height: 46px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }
    .stat-value {
      font-size: 2rem;
      font-weight: 700;
      color: var(--color-primary);
      line-height: 1.1;
      margin-top: 8px;
    }
    .stat-label {
      font-size: 13px;
      color: var(--color-text-muted);
    }
  </style>
</head>
<body>
<form runat="server" enctype="multipart/form-data">
  <asp:ScriptManager runat="server" />
  <div class="admin-shell">

    <!-- Sidebar -->
    <aside class="admin-sidebar instructor-sidebar">
      <div class="brand">
        <i class="bi bi-mortarboard-fill" style="color:var(--color-accent);"></i> EduFlow
        <div class="brand-sub">Eğitmen Paneli</div>
      </div>
      <nav>
        <div class="sidebar-section-label">Genel</div>
        <a href="Dashboard.aspx"><i class="bi bi-speedometer2"></i> Dashboard</a>

        <div class="sidebar-section-label">Kurslarım</div>
        <a href="MyCourses.aspx"><i class="bi bi-collection-play"></i> Kurs Listesi</a>
        <a href="AddCourse.aspx"><i class="bi bi-plus-circle"></i> Yeni Kurs Ekle</a>

        <div class="sidebar-section-label">Öğrenciler</div>
        <a href="Students.aspx"><i class="bi bi-people"></i> Öğrencilerim</a>

        <div class="sidebar-section-label">Hesap</div>
        <a href="../Default.aspx"><i class="bi bi-house"></i> Siteye Dön</a>
        <a href="../Logout.aspx"><i class="bi bi-box-arrow-right"></i> Çıkış</a>
      </nav>
    </aside>

    <!-- Main -->
    <main class="admin-main">
      <div class="admin-topbar instructor-topbar">
        <h1><%: Page.Title %></h1>
        <div class="admin-user">
          <div style="width:34px;height:34px;border-radius:50%;background:var(--color-primary-light);color:var(--color-primary);display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:600;">
            <%: (Session["FullName"] ?? "E").ToString().Substring(0,1).ToUpper() %>
          </div>
          <span><%: Session["FullName"] ?? "Eğitmen" %></span>
          <a href="../Logout.aspx" class="btn btn-outline-custom btn-sm">Çıkış</a>
        </div>
      </div>
      <asp:ContentPlaceHolder ID="InstructorContent" runat="server" />
    </main>
  </div>
</form>
<script src="../Scripts/bootstrap.bundle.min.js"></script>
<script>
  (function(){
    var path = window.location.pathname.split('/').pop();
    document.querySelectorAll('.instructor-sidebar a').forEach(function(a){
      if(a.getAttribute('href') === path) a.classList.add('active');
    });
  })();
</script>
</body>
</html>
